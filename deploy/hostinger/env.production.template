# /var/www/shilpikala/.env.production  (created by setup-server.sh; fill in the empty values, then run deploy.sh)
# Next.js reads this file on build and start. Never commit it.
NEXT_PUBLIC_SITE_URL=https://${DOMAIN}
SITE_URL=https://${DOMAIN}

# Database: PostgreSQL on this same server (no SSL needed on localhost)
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@127.0.0.1:5432/${DB_NAME}
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Admin area (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=${ADMIN_PASSWORD}

# Razorpay (Dashboard > Settings > API Keys, and Webhooks)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (Resend) — verify ${DOMAIN} in Resend first
RESEND_API_KEY=
ORDER_EMAIL_FROM=orders@${DOMAIN}
INVOICE_EMAIL_FROM=invoice@${DOMAIN}
ACCOUNT_EMAIL_FROM=account@${DOMAIN}
EMAIL_GENERAL_FROM=hello@${DOMAIN}
ADMIN_EMAIL=

# Business details printed on invoices
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_GSTIN=
BUSINESS_STATE=
GST_RATE_PERCENT=
INVOICE_PREFIX=SK

# Generated for you. Keep them; do not change RETURNS_ENCRYPTION_KEY later.
CRON_SECRET=${CRON_SECRET}
RETURNS_ENCRYPTION_KEY=${RETURNS_ENCRYPTION_KEY}
RETURN_WINDOW_DAYS=7
# Your own server has no 4.5 MB request limit, so longer unboxing videos are possible.
RETURN_VIDEO_MAX_MB=25
