{
  "name": "shilpikala",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/remove-stale-files.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/remove-stale-files.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "node scripts/remove-stale-files.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "tsx --tsconfig tsconfig.json scripts/db-migrate.ts",
    "db:import-legacy": "tsx --tsconfig tsconfig.json scripts/import-legacy.ts",
    "db:check": "tsx --tsconfig tsconfig.json scripts/db-check.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "next": "16.3.6",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
