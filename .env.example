# ---------------------------------------------------------------------
# ShilpiKala — environment variables
# Copy to .env.local for development. In production, set these in your
# host's environment settings. NEVER commit real values.
# ---------------------------------------------------------------------

# Public URL of the site (no trailing slash). Used for canonical URLs,
# the sitemap, and links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database --------------------------------------------------------
# PostgreSQL connection string. REQUIRED in production.
# If left empty, the app uses an embedded database stored in
# storage/pgdata — fine for local development, NOT for production.
DATABASE_URL=
# Optional: set to "true" if your provider requires SSL (most managed Postgres do).
DATABASE_SSL=
# Optional: max connections per server instance (default 5; keep low on serverless).
DATABASE_POOL_MAX=

# --- Payments (Razorpay) --------------------------------------------
# Key ID is public by design (it is sent to the browser); the secret is not.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Admin area (/admin) --------------------------------------------
# HTTP Basic Auth. Use a long random password. If either is empty the
# admin area stays locked.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Email (Resend) -------------------------------------------------
# Order confirmations, shipping notices, password resets, inquiry alerts.
# Without these the site works, but no emails are sent.
RESEND_API_KEY=
# Must be a sender on a domain you have verified with Resend.
EMAIL_FROM=
# Where new-order and new-inquiry alerts go.
ADMIN_NOTIFICATION_EMAIL=
